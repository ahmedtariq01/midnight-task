    {
      "id": 15,
      "title": "Backlog trend",
      "description": "Each falling line shows the corresponding service closing its gap. A peer target can change when peers reconnect.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
