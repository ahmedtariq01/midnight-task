    },
    {
      "id": 21,
      "title": "Archive progress to peer tip",
      "description": "Archive best divided by its peer target. A missing or zero target leaves the panel empty.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * clamp_max(max without (status) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"best\"}) / (max without (status) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"sync_target\"}) > 0), 1)",
          "legendFormat": "Archive progress to peer tip",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Archive to peer tip",
      "description": "Peer-observed sync target minus best height. The target is useful for replay progress and can move independently of public finality.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(max by (job, instance, chain) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"sync_target\"}) - max by (job, instance, chain) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"best\"}), 0)",
          "legendFormat": "Archive backlog",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Indexer progress to local finality",
      "description": "Indexed height divided by the archive finalized height sampled by the same probe.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * clamp_max(((midnight_ops_indexer_height{job=\"node\"}) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))) / (midnight_ops_indexer_node_finalized_height{job=\"node\"} > 0), 1)",
          "legendFormat": "Indexer progress to local finality",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Indexer to local finality",
      "description": "Archive finalized height minus GraphQL height in a successful probe less than three minutes old.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
