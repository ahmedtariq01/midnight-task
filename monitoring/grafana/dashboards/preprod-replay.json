{
  "id": null,
  "uid": "preprod-replay",
  "title": "PreProd Replay",
  "tags": [
    "preprod",
    "cardano",
    "midnight",
    "replay"
  ],
  "description": "Follow Midnight archive and indexer replay, Cardano DB Sync, and probe freshness. The archive target comes from its peers, and indexer readiness is relative to the local archive.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 5,
      "title": "Archive sync state",
      "description": "The node’s major-sync flag. Its absence is shown as no data. A cleared flag alone cannot establish a hash match with public PreProd.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Major sync off",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Syncing",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_sub_libp2p_is_major_syncing{job=\"midnight-node\",chain=\"midnight_preprod\"}",
          "legendFormat": "Archive sync",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Indexer readiness",
      "description": "HTTP readiness relative to the local archive. The endpoint can return 503 during replay. No data means the probe did not return a fresh usable result.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HTTP 503",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "HTTP 200",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "midnight_ops_indexer_ready{job=\"node\"} and on (job, instance) (time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*/midnight-replay[.]prom\"} < 180)",
          "legendFormat": "Indexer readiness",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Indexer hash check",
      "description": "Compares the indexed hash with the archive hash at that same height. A public comparison is still needed to establish network catch-up.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Mismatch",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Match",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "(midnight_ops_indexer_same_height_hash_match{job=\"node\"}) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))",
          "legendFormat": "Indexer hash check",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Midnight peers",
      "description": "Connected peers. The existing Prometheus rule triggers below three peers for five minutes.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_sub_libp2p_peers_count{job=\"midnight-node\",chain=\"midnight_preprod\"}",
          "legendFormat": "Midnight peers",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
