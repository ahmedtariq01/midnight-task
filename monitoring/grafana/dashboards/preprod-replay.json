          "editorMode": "code",
          "expr": "(midnight_ops_cardano_relay_height{job=\"node\"}) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"cardano\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"cardano\"} < 180))",
          "legendFormat": "Relay",
