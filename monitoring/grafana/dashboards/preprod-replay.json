        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "(midnight_ops_indexer_height{job=\"node\"}) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))",
          "legendFormat": "Indexed",
          "range": true,
          "instant": false,
          "refId": "D"
        }
      ]
    },
    {
      "id": 10,
      "title": "Midnight blocks per second",
      "description": "Fifteen-minute regression of each block-height gauge. Archive and indexer rates can vary as the replay traverses different block types.",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: blocks/s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "deriv(substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"best\"}[15m])",
          "legendFormat": "Archive best",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "deriv(substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"finalized\"}[15m])",
          "legendFormat": "Archive finalized",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "(deriv(midnight_ops_indexer_height{job=\"node\"}[15m])) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))",
          "legendFormat": "Indexed",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ]
    },
    {
