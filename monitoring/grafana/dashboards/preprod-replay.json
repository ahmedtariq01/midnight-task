{
  "id": null,
  "uid": "preprod-replay",
  "title": "PreProd Replay",
  "tags": [
    "preprod",
    "cardano",
    "midnight",
    "replay"
  ],
  "description": "Cardano and Midnight progress, readiness, and chain agreement.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Midnight metrics",
      "description": "Prometheus scrape health for the Midnight node. Check the telemetry alert and service journal when down.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"midnight-node\"}",
          "legendFormat": "Midnight metrics",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Midnight peers",
      "description": "Connected peers. The existing Prometheus rule triggers below three peers for five minutes.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_sub_libp2p_peers_count{job=\"midnight-node\",chain=\"midnight_preprod\"}",
          "legendFormat": "Midnight peers",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Archive backlog",
      "description": "Peer-observed sync target minus best height. The target is useful for replay progress and can move independently of public finality.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(max by (job, instance, chain) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"sync_target\"}) - max by (job, instance, chain) (substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"best\"}), 0)",
          "legendFormat": "Archive backlog",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Indexer backlog",
      "description": "Archive finalized height minus GraphQL height in a successful probe less than three minutes old.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "(clamp_min(midnight_ops_indexer_node_finalized_height{job=\"node\"} - midnight_ops_indexer_height{job=\"node\"}, 0)) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))",
          "legendFormat": "Indexer backlog",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Archive sync",
      "description": "The native major-sync flag reflects whether the node reports that it is still replaying.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Following",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Syncing",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_sub_libp2p_is_major_syncing{job=\"midnight-node\",chain=\"midnight_preprod\"}",
          "legendFormat": "Archive sync",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Indexer API",
      "description": "Result from the HTTP liveness probe. The sampler file must have been updated within the last three minutes.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Live",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "midnight_ops_indexer_live{job=\"node\"} and on (job, instance) (time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*/midnight-replay[.]prom\"} < 180)",
          "legendFormat": "Indexer API",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Indexer readiness",
      "description": "HTTP readiness is relative to the local archive. Catching up is expected while indexed height advances. The sampler file must be less than three minutes old.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Catching up",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "midnight_ops_indexer_ready{job=\"node\"} and on (job, instance) (time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*/midnight-replay[.]prom\"} < 180)",
          "legendFormat": "Indexer readiness",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Indexer hash check",
      "description": "Compares the indexed hash with the archive hash at that same height. A public comparison is still needed to establish network catch-up.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Mismatch",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Match",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "(midnight_ops_indexer_same_height_hash_match{job=\"node\"}) and on (job, instance) ((midnight_ops_probe_success{job=\"node\",component=\"indexer\"} == 1) and on (job, instance) (time() - midnight_ops_probe_last_success_timestamp_seconds{job=\"node\",component=\"indexer\"} < 180))",
          "legendFormat": "Indexer hash check",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Midnight archive and indexer heights",
      "description": "Best, finalized, and peer-target heights from native metrics. GraphQL height appears when the indexer probe succeeds.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"sync_target\"}",
          "legendFormat": "Peer target",
          "range": true,
          "instant": false,
          "refId": "A"
