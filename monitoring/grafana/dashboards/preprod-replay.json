        {
          "datasource": {
            "type": "prometheus",
            "uid": "preprod-prometheus"
          },
          "editorMode": "code",
          "expr": "substrate_block_height{job=\"midnight-node\",chain=\"midnight_preprod\",status=\"finalized\"}",
          "legendFormat": "Archive finalized",
          "range": true,
          "instant": false,
