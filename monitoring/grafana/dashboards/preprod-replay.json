    {
      "id": 14,
      "title": "Probe age",
      "description": "Seconds since each probe last succeeded and since the sampler last updated its metrics file. If only a component's age rises, inspect its RPC or SQL calls.",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 20,
        "w": 10,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "preprod-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
