{
  "id": null,
  "uid": "preprod-aws",
  "title": "PreProd AWS EC2 and EBS",
  "tags": [
    "preprod",
    "cloudwatch",
    "ec2",
    "ebs"
  ],
  "description": "Native CloudWatch metrics for the Ohio instance and its mounted data volume.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "5m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance_id",
        "label": "EC2 instance ID",
        "type": "textbox",
        "query": "__PREPROD_INSTANCE_ID__",
        "current": {
          "selected": false,
          "text": "__PREPROD_INSTANCE_ID__",
          "value": "__PREPROD_INSTANCE_ID__"
        }
      },
      {
        "name": "data_volume_id",
        "label": "Data EBS volume ID",
        "type": "textbox",
        "query": "__PREPROD_DATA_VOLUME_ID__",
        "current": {
          "selected": false,
          "text": "__PREPROD_DATA_VOLUME_ID__",
          "value": "__PREPROD_DATA_VOLUME_ID__"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Replay",
      "type": "link",
      "url": "/d/preprod-replay",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Host and EBS",
      "type": "link",
      "url": "/d/preprod-host-ebs",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Service logs",
      "type": "link",
      "url": "/d/preprod-service-logs",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "EC2 CPU utilization",
      "description": "Average and peak instance utilization over each five-minute period.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "preprod-cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "preprod-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/EC2",
          "metricName": "CPUUtilization",
          "dimensions": {
            "InstanceId": [
              "$instance_id"
            ]
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "300",
          "label": "Average",
          "refId": "A",
          "id": "m1"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "preprod-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-2",
          "namespace": "AWS/EC2",
          "metricName": "CPUUtilization",
          "dimensions": {
            "InstanceId": [
              "$instance_id"
            ]
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "300",
          "label": "Maximum",
          "refId": "B",
          "id": "m2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
